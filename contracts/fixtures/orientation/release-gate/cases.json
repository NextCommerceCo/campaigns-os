          "compatibility": "additive",
          "migration": "none",
          "changes": [
            { "class": "cli_surface", "path": null, "surface_entry": "build", "summary": "campaigns-os build gained a flag." },
            { "class": "cli_surface", "path": "src/cli.mjs", "surface_entry": "build", "summary": "The dispatch table learned the new flag." }
          ]
