{
  "name": "@nextcommerce/campaigns-os",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Toolkit for agent-assisted NEXT campaign builds.",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "campaigns-os": "./bin/campaigns-os.mjs"
  },
  "exports": {
    "./commercial-journey": {
      "import": "./src/commercial-journey.mjs",
      "default": "./src/commercial-journey.mjs"
    },
    "./commercial-parity": {
      "import": "./src/commercial-parity.mjs",
      "default": "./src/commercial-parity.mjs"
    },
    "./campaign-spec": {
      "types": "./campaign-spec/dist/index.d.ts",
      "import": "./campaign-spec/dist/index.js",
      "default": "./campaign-spec/dist/index.js"
    },
    "./schemas/campaign-spec.v4.schema.json": "./schemas/campaign-spec.v4.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "campaigns-os": "node ./bin/campaigns-os.mjs",
    "skills": "bash ./skills.sh",
    "qa": "node ./bin/campaigns-os.mjs qa",
    "qa:install-browser": "npx playwright install chromium",
    "smoke:polish-capture": "node ./scripts/smoke-polish-capture.mjs --run",
    "refresh:starter-catalog": "node ./scripts/refresh-starter-template-catalog.mjs",
    "build:spec": "tsc -p campaign-spec/tsconfig.build.json",
    "prepare": "npm run build:spec",
    "check:spec": "node --test \"campaign-spec/test/**/*.test.ts\"",
    "check": "node ./scripts/check-catalog-provenance.mjs && node ./scripts/check-workflow-contracts.mjs && npm run build:spec && node --test ./src/*.test.mjs ./scripts/refresh-starter-template-catalog.test.mjs ./scripts/check-catalog-provenance.test.mjs ./scripts/check-workflow-contracts.test.mjs ./scripts/check-slot-manifest.test.mjs ./scripts/check-skill-versions.test.mjs ./scripts/check-supported-surface.test.mjs ./scripts/check-campaign-spec-conformance.test.mjs ./scripts/check-release-ledger.test.mjs ./scripts/generate-orientation-reference.test.mjs ./scripts/check-runtime-recipe.test.mjs && npm run check:spec && node ./scripts/check-fixtures.mjs && node ./scripts/check-campaign-spec-conformance.mjs && node ./scripts/check-private-strings.mjs && node ./scripts/check-template-doctrine.mjs && node ./scripts/check-slot-manifest.mjs && node ./scripts/check-skill-versions.mjs && node ./scripts/check-cart-readiness-contract.mjs && npm run check:sidecar-bundle && node ./scripts/check-supported-surface.mjs && node ./scripts/check-release-ledger.mjs && node ./scripts/check-runtime-recipe.mjs && npm run check:orientation-docs && npm run check:runtime-docs && node ./scripts/check-pack.mjs --skip-prepare",
    "check:fixtures": "node ./scripts/check-fixtures.mjs",
    "check:spec-conformance": "node ./scripts/check-campaign-spec-conformance.mjs",
    "check:pack": "node ./scripts/check-pack.mjs",
    "check:private-strings": "node ./scripts/check-private-strings.mjs",
    "check:template-doctrine": "node ./scripts/check-template-doctrine.mjs",
    "check:cart-readiness": "node ./scripts/check-cart-readiness-contract.mjs",
    "check:provenance": "node ./scripts/check-catalog-provenance.mjs",
    "check:workflows": "node ./scripts/check-workflow-contracts.mjs",
    "check:skill-versions": "node ./scripts/check-skill-versions.mjs",
    "check:release-ledger": "node ./scripts/check-release-ledger.mjs",
    "check:orientation-docs": "node ./scripts/generate-orientation-reference.mjs --check",
    "generate:orientation-docs": "node ./scripts/generate-orientation-reference.mjs --write",
    "check:runtime-recipe": "node ./scripts/check-runtime-recipe.mjs",
    "check:runtime-docs": "node ./scripts/generate-runtime-readiness.mjs --check",
    "generate:runtime-docs": "node ./scripts/generate-runtime-readiness.mjs --write",
    "check:sidecar-bundle": "node ./bin/campaigns-os.mjs bundle check --packet contracts/fixtures/sidecar-bundle/production-shaped/campaign-runtime.build.json --require-qa --json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "playwright": "^1.62.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "files": [
    "agents",
    "bin",
    "campaign-spec",
    "contracts",
    "docs",
    "examples",
    "prompts",
    "schemas",
    "scripts",
    "skills.sh",
    "skills",
    "skills.json",
    "src",
    "README.md",
    "CONTEXT.md",
    "compatibility.json",
    "AGENTS.md",
    "CHANGELOG.md"
  ]
}
